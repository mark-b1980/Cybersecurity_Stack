<!--
  Sysmon for Linux baseline config | Incident-response focused, low noise, MITRE ATT&CK v20.1 tagged
  Version:	1.0 | Date: 2026-11-18
  Target:	Sysmon for Linux 1.6.0+ | schemaversion 4.90
		Debian / Ubuntu / Linux Mint / Kali / Parrot and RHEL / Rocky / Alma / Oracle / Fedora (merged /usr)

  Same philosophy as the Windows baseline (sysmon-baseline.xml): log what matters for an investigation,
  exclude noise with exact paths, tag rules with MITRE ATT&CK (RuleName: technique_id=...,technique_name=...).

  EVENTS IMPLEMENTED BY SYSMON FOR LINUX
	  1 ProcessCreate	ON  all, noise excluded, untagged (MITRE mapping in ELK)
	  3 NetworkConnect	ON  shells/interpreters/tools connecting, staging paths, suspicious ports (outbound only)
	  5 ProcessTerminate	ON  staging paths, security/logging agents ending
	  9 RawAccessRead	OFF (fsck/blkid/LVM/udisks noise)
	 10 ProcessAccess	ON  every ptrace attach (rare on Linux), debuggers kept
	 11 FileCreate		ON  persistence locations, accounts, sudo, PAM, linker, modules, webshells
	 23 FileDelete		ON  narrow: logs, shell history, audit config, staging tools, backups (no archiving)
	100 eBPFEvent		ON  eBPF programs loaded (rootkits), systemd/container runtimes/Sysmon excluded
  Not available on Linux: registry, DNS, pipes, WMI, ADS, tampering, block events, hashes.

  TECHNICAL:
  - The "image" condition only splits on "\" and does not work on Linux. Binaries are matched with "end with /name".
  - Conditions are case-insensitive. Exclude always wins over include.
  - Output goes to syslog/journald. Raise the rsyslog message size ($MaxMessageSize 64k) - FieldSizes below caps long fields.
-->

<Sysmon schemaversion="4.90">
	<!--SYSMON META CONFIG-->
	<FieldSizes>CommandLine:4096,ParentCommandLine:4096,Image:1024,ParentImage:1024,CurrentDirectory:512,TargetFilename:1024</FieldSizes> <!--Cap field length so syslog does not truncate events-->
	<DnsLookup>False</DnsLookup> <!--No reverse lookups for NetworkConnect-->

	<EventFiltering>

	<!--SYSMON EVENT ID 1 : PROCESS CREATION [ProcessCreate]-->
		<!--COMMENT:	All processes are logged except high-frequency noise below. Untagged: MITRE mapping is done in ELK.-->
	<RuleGroup name="" groupRelation="or">
		<ProcessCreate onmatch="exclude">
			<!--SECTION: systemd helpers (very frequent, root-owned)-->
			<Image condition="end with">/systemd/systemd-userwork</Image> <!--systemd-userdbd worker, spawned constantly-->
			<Image condition="end with">/systemd/systemd-user-runtime-dir</Image>
			<!--SECTION: Login banner scripts (Ubuntu/Debian motd on every SSH login) - new scripts there are caught by #11-->
			<ParentCommandLine condition="contains">/etc/update-motd.d</ParentCommandLine>
			<Image condition="end with">/update-notifier/update-motd-updates-available</Image>
			<Image condition="end with">/update-notifier/apt-check</Image>
			<!--SECTION: NetworkManager dispatcher (laptops) - new scripts there are caught by #11-->
			<ParentImage condition="end with">/nm-dispatcher</ParentImage>
			<!--SECTION: sysstat / php session cleanup cron jobs (every 10-30 min)-->
			<CommandLine condition="contains">/sysstat/debian-sa1</CommandLine>
			<CommandLine condition="contains">/sa/sa1 </CommandLine>
			<CommandLine condition="end with">/sa/sa1</CommandLine>
			<CommandLine condition="contains">/usr/lib/php/sessionclean</CommandLine>
			<!--SECTION: SSH pre-authentication helpers (internet-facing servers: brute force noise). Post-login shells stay logged.-->
			<Image condition="end with">/sshd-auth</Image> <!--OpenSSH 10+ pre-auth-->
			<CommandLine condition="end with"> [net]</CommandLine> <!--OpenSSH pre-auth privsep child-->
			<CommandLine condition="end with"> [preauth]</CommandLine>
			<!--SECTION: Container runtime internals (healthcheck commands and container processes stay logged)-->
			<CommandLine condition="is">runc init</CommandLine>
			<CommandLine condition="is">crun init</CommandLine>
			<!--SECTION: Monitoring agents running their periodic checks (root-owned install paths)-->
			<ParentImage condition="end with">/zabbix_agentd</ParentImage>
			<ParentImage condition="end with">/zabbix_agent2</ParentImage>
			<ParentCommandLine condition="contains">/usr/bin/check_mk_agent</ParentCommandLine>
			<ParentImage condition="end with">/sbin/nrpe</ParentImage>
			<ParentImage condition="end with">/bin/telegraf</ParentImage>
			<ParentImage condition="begin with">/var/ossec/bin/</ParentImage> <!--Wazuh agent commands (netstat, df, last ...)-->
			<ParentImage condition="begin with">/usr/libexec/netdata/</ParentImage>
			<ParentImage condition="begin with">/opt/netdata/</ParentImage>
			<!--SECTION: Browser / Electron child processes (renderer, GPU, utility) - main process stays logged-->
			<Rule groupRelation="and">
				<Image condition="begin with">/opt/google/chrome/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/opt/brave.com/brave/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/opt/microsoft/msedge/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/usr/lib/chromium/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/usr/lib64/chromium-browser/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/snap/chromium/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/usr/share/code/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/opt/visual-studio-code/</Image>
				<CommandLine condition="contains"> --type=</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/usr/lib/firefox/</Image>
				<CommandLine condition="contains"> -contentproc</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/usr/lib64/firefox/</Image>
				<CommandLine condition="contains"> -contentproc</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/usr/lib/firefox-esr/</Image>
				<CommandLine condition="contains"> -contentproc</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/snap/firefox/</Image>
				<CommandLine condition="contains"> -contentproc</CommandLine>
			</Rule>
			<Rule groupRelation="and">
				<Image condition="begin with">/opt/firefox/</Image>
				<CommandLine condition="contains"> -contentproc</CommandLine>
			</Rule>
		</ProcessCreate>
	</RuleGroup>

	<!--SYSMON EVENT ID 3 : NETWORK CONNECTION [NetworkConnect]-->
		<!--COMMENT:	Targeted and outbound only (Initiated=true): shells/interpreters, attacker tools, staging paths, suspicious ports. Inbound brute force is not logged here.-->
	<RuleGroup name="" groupRelation="or">
		<NetworkConnect onmatch="include">
			<!--Execution from staging locations or memory-->
			<Rule groupRelation="and" name="technique_id=T1071,technique_name=Application Layer Protocol"> <!--World-writable temp-->
				<Image condition="begin with">/tmp/</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1071,technique_name=Application Layer Protocol"> <!--World-writable temp, survives reboot-->
				<Image condition="begin with">/var/tmp/</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1071,technique_name=Application Layer Protocol"> <!--RAM disk - classic malware staging-->
				<Image condition="begin with">/dev/shm/</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1071,technique_name=Application Layer Protocol">
				<Image condition="begin with">/run/shm/</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1071,technique_name=Application Layer Protocol"> <!--Fileless execution from memory (memfd_create)-->
				<Image condition="begin with">/memfd:</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1620,technique_name=Reflective Code Loading"> <!--Binary deleted after start-->
				<Image condition="end with"> (deleted)</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1071,technique_name=Application Layer Protocol"> <!--User-owned binaries (like C:\Users on Windows)-->
				<Image condition="begin with">/home/</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1071,technique_name=Application Layer Protocol">
				<Image condition="begin with">/root/</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1505.003,technique_name=Web Shell"> <!--Binary in webroot-->
				<Image condition="begin with">/var/www/</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<!--Interpreters (resolved real paths carry version suffixes, e.g. /usr/bin/python3.12, /usr/bin/php8.2)-->
			<Rule groupRelation="and" name="technique_id=T1059.006,technique_name=Python">
				<Image condition="begin with">/usr/bin/python</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059.006,technique_name=Python">
				<Image condition="begin with">/usr/local/bin/python</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059.006,technique_name=Python">
				<Image condition="begin with">/usr/libexec/platform-python</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059,technique_name=Command and Scripting Interpreter">
				<Image condition="begin with">/usr/bin/perl</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059,technique_name=Command and Scripting Interpreter">
				<Image condition="begin with">/usr/bin/ruby</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059,technique_name=Command and Scripting Interpreter">
				<Image condition="begin with">/usr/bin/php</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059,technique_name=Command and Scripting Interpreter">
				<Image condition="begin with">/usr/bin/lua</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<!--Shells (reverse shells via /dev/tcp)-->
			<Rule groupRelation="and" name="technique_id=T1059.004,technique_name=Unix Shell">
				<Image condition="end with">/bash</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059.004,technique_name=Unix Shell">
				<Image condition="end with">/sh</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059.004,technique_name=Unix Shell">
				<Image condition="end with">/dash</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059.004,technique_name=Unix Shell">
				<Image condition="end with">/zsh</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059.004,technique_name=Unix Shell">
				<Image condition="end with">/ksh</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1059.004,technique_name=Unix Shell">
				<Image condition="end with">/busybox</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<!--Raw socket tools-->
			<Rule groupRelation="and" name="technique_id=T1095,technique_name=Non-Application Layer Protocol">
				<Image condition="end with">/nc</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1095,technique_name=Non-Application Layer Protocol">
				<Image condition="end with">/ncat</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1095,technique_name=Non-Application Layer Protocol">
				<Image condition="end with">/netcat</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1095,technique_name=Non-Application Layer Protocol">
				<Image condition="end with">/nc.openbsd</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1095,technique_name=Non-Application Layer Protocol">
				<Image condition="end with">/nc.traditional</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1095,technique_name=Non-Application Layer Protocol">
				<Image condition="end with">/socat</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1021,technique_name=Remote Services">
				<Image condition="end with">/telnet</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1573,technique_name=Encrypted Channel">
				<Image condition="end with">/openssl</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<!--Download tools-->
			<Rule groupRelation="and" name="technique_id=T1105,technique_name=Ingress Tool Transfer">
				<Image condition="end with">/curl</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1105,technique_name=Ingress Tool Transfer">
				<Image condition="end with">/wget</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1105,technique_name=Ingress Tool Transfer">
				<Image condition="end with">/tftp</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1105,technique_name=Ingress Tool Transfer">
				<Image condition="end with">/ftp</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<!--Remote access / lateral movement-->
			<Rule groupRelation="and" name="technique_id=T1021.004,technique_name=SSH">
				<Image condition="end with">/ssh</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1021.004,technique_name=SSH">
				<Image condition="end with">/scp</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1021.004,technique_name=SSH">
				<Image condition="end with">/sftp</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1021.002,technique_name=SMB/Windows Admin Shares">
				<Image condition="end with">/smbclient</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1021.001,technique_name=Remote Desktop Protocol">
				<Image condition="end with">/xfreerdp</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1021.001,technique_name=Remote Desktop Protocol">
				<Image condition="end with">/rdesktop</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<!--Scanners / brute force-->
			<Rule groupRelation="and" name="technique_id=T1046,technique_name=Network Service Discovery">
				<Image condition="end with">/nmap</Image>
				<Initiated condition="is">true</Initiated>
			</Rule>
			<Rule groupRelation="and" name="technique_id=T1046,technique_name=Network Service Discovery">
